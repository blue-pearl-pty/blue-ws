<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://www.blueapp.blue/pdf/v1"
           targetNamespace="http://www.blueapp.blue/pdf/v1"
           xmlns:api="http://www.blueapp.blue/shared/api/v1"
           elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">

    <xs:import namespace="http://www.blueapp.blue/shared/api/v1" schemaLocation="../shared/api.xsd"/>

    <xs:element name="TimesheetReportTemplate" type="tns:TimesheetReportTemplate"/>
    <xs:element name="InvoiceTemplate" type="tns:InvoiceTemplate"/>

    <xs:complexType name="TimesheetReportTemplate">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="dateFrom" type="xs:date"/>
            <xs:element name="dateTo" type="xs:date"/>
            <xs:element name="timesheetEntries" type="tns:TimesheetEntry" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="TimesheetEntry">
        <xs:sequence>
            <xs:element name="date" type="xs:date"/>
            <xs:element name="minutes" type="xs:int"/>
            <xs:element name="description" type="xs:string"/>
            <xs:element name="activity" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="InvoiceTemplate">
        <xs:sequence>
            <xs:element name="company" type="tns:Company"/>
            <xs:element name="number" type="xs:string"/>
            <xs:element name="date" type="xs:date"/>
            <xs:element name="reference" type="xs:string" />
            <xs:element name="amountExcludingVAT" type="api:MonetaryAmount" />
            <xs:element name="vatRate" type="xs:decimal" />
            <xs:element name="subTotal" type="api:MonetaryAmount" />
            <xs:element name="vat" type="api:MonetaryAmount" />
            <xs:element name="total" type="api:MonetaryAmount" />
            <xs:element name="lineItems" type="tns:LineItem" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Company">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="vatNumber" type="xs:string"/>
            <xs:element name="postalAddress" type="xs:string" minOccurs="0" maxOccurs="1"/>
            <xs:element name="physicalAddress" type="xs:string" minOccurs="0" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LineItem">
        <xs:sequence>
            <xs:element name="quantity" type="xs:decimal" />
            <xs:element name="amountExcludingVAT" type="api:MonetaryAmount" />
            <xs:element name="type" type="tns:LineItemType" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LineItemType">
        <xs:sequence>
            <xs:element name="description" type="xs:string"/>
            <xs:element name="code" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>