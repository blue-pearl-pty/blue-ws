<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<jaxb:bindings
        xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:annox="http://annox.dev.java.net"
    xmlns:xjc="https://jakarta.ee/xml/ns/jaxb/xjc"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jaxb https://jakarta.ee/xml/ns/jaxb/bindingschema_3_0.xsd"
        version="3.0">
    <jaxb:bindings schemaLocation="../shared/api.xsd" node="/xs:schema">
        <jaxb:bindings node="xs:complexType[@name='APIError']">
            <annox:annotate>
                <annox:annotate annox:class="lombok.Builder"/>
                <annox:annotate annox:class="lombok.NoArgsConstructor"/>
                <annox:annotate annox:class="lombok.AllArgsConstructor"/>
            </annox:annotate>
        </jaxb:bindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="../shared/api.xsd" node="/xs:schema">
        <jaxb:bindings node="xs:complexType[@name='APIError']/xs:sequence/xs:element[@name='timestamp']">
            <annox:annotate target="field">
                <annox:annotate annox:class="com.fasterxml.jackson.annotation.JsonFormat" pattern="yyyy-MM-dd'T'HH:mm:ss.SSSZ"/>
            </annox:annotate>
        </jaxb:bindings>
    </jaxb:bindings>
</jaxb:bindings>