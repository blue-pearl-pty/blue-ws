<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<jaxb:bindings
        xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:annox="http://annox.dev.java.net"
    xmlns:xjc="https://jakarta.ee/xml/ns/jaxb/xjc"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jaxb https://jakarta.ee/xml/ns/jaxb/bindingschema_3_0.xsd"
        version="3.0">
    <jaxb:bindings schemaLocation="../registration/registration.xsd" node="/xs:schema">
        <jaxb:bindings node="xs:complexType[@name='CreateUserRequest']/xs:sequence/xs:element[@name='emailAddress']">
            <annox:annotate target="field">
                <annox:annotate annox:class="jakarta.validation.constraints.Email" message="Email address must be a valid email."/>
                <annox:annotate annox:class="jakarta.validation.constraints.NotEmpty" message="Email address must not be empty."/>
                <annox:annotate annox:class="jakarta.validation.constraints.NotNull" message="Email address must not be null."/>
            </annox:annotate>
        </jaxb:bindings>
    </jaxb:bindings>
    <jaxb:bindings schemaLocation="../registration/registration.xsd" node="/xs:schema">
        <jaxb:bindings node="xs:complexType[@name='CreateUserRequest']/xs:sequence/xs:element[@name='type']">
            <annox:annotate target="field">
                <annox:annotate annox:class="jakarta.validation.constraints.NotNull" message="User type must not be null."/>
            </annox:annotate>
        </jaxb:bindings>
    </jaxb:bindings>
    <jaxb:bindings schemaLocation="../registration/registration.xsd" node="/xs:schema">
        <jaxb:bindings node="xs:complexType[@name='CreateUserRequest']/xs:sequence/xs:element[@name='status']">
            <annox:annotate target="field">
                <annox:annotate annox:class="jakarta.validation.constraints.NotNull" message="User status must not be null."/>
            </annox:annotate>
        </jaxb:bindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="../registration/registration.xsd" node="/xs:schema">
        <jaxb:bindings node="xs:complexType[@name='UpdateUserRequest']/xs:sequence/xs:element[@name='status']">
            <annox:annotate target="field">
                <annox:annotate annox:class="jakarta.validation.constraints.NotNull" message="User status must not be null."/>
            </annox:annotate>
        </jaxb:bindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="../registration/registration.xsd" node="/xs:schema">
        <jaxb:bindings node="xs:complexType[@name='UserLookupResponse']">
            <annox:annotate>
                <annox:annotate annox:class="lombok.NoArgsConstructor"/>
                <annox:annotate annox:class="lombok.AllArgsConstructor"/>
            </annox:annotate>
        </jaxb:bindings>
    </jaxb:bindings>
</jaxb:bindings>