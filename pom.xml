<?xml version="1.0" encoding="UTF-8"?>

<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>za.co.bluepearl</groupId>
    <artifactId>blue-ws</artifactId>
    <version>1.1.0</version>

    <packaging>pom</packaging>

    <name>Blue Web Service Contracts</name>
    <description>Generates the API Schema Model used by Blue Web Service Clients and Service Providers</description>

    <properties>
        <api.episode.file>${api.generate.directory}/META-INF/JAXB/api.episode.xjb</api.episode.file>
        <api.generate.directory>${project.build.directory}/generated-sources/xjc/api</api.generate.directory>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <jaxb.api.version>4.0.2</jaxb.api.version>
        <jaxb.tools.version>4.0.3</jaxb.tools.version>
        <jaxb.core.version>4.0.3</jaxb.core.version>
        <jakarta.activation.version>2.1.3</jakarta.activation.version>
        <jakarta.validation.version>3.0.2</jakarta.validation.version>
        <jackson.version>2.17.1</jackson.version>
        <lombok.version>1.18.34</lombok.version>
        <jaxb2-maven-plugin.version>3.1.0</jaxb2-maven-plugin.version>
        <jaxb2-basics.version>1.11.1-PUBLISHED-BY-MISTAKE</jaxb2-basics.version>
        <jaxb2-basics-annotate.version>1.1.0</jaxb2-basics-annotate.version>
        <javax.jaxb-api.version>2.3.1</javax.jaxb-api.version>
        <exec-maven-plugin.version>3.1.1</exec-maven-plugin.version>
        <maven-dependency-plugin.version>3.6.1</maven-dependency-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${jakarta.validation.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>${jaxb.api.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.activation</groupId>
            <artifactId>jakarta.activation-api</artifactId>
            <version>${jakarta.activation.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>jaxb2-maven-plugin</artifactId>
                    <version>${jaxb2-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jvnet.jax-ws-commons</groupId>
                    <artifactId>jaxws-maven-plugin</artifactId>
                    <version>2.3</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxb2-maven-plugin</artifactId>

                <dependencies>
                    <dependency>
                        <groupId>jakarta.validation</groupId>
                        <artifactId>jakarta.validation-api</artifactId>
                        <version>${jakarta.validation.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>jakarta.xml.bind</groupId>
                        <artifactId>jakarta.xml.bind-api</artifactId>
                        <version>${jaxb.api.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>jakarta.activation</groupId>
                        <artifactId>jakarta.activation-api</artifactId>
                        <version>${jakarta.activation.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.projectlombok</groupId>
                        <artifactId>lombok</artifactId>
                        <version>${lombok.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-annotations</artifactId>
                        <version>${jackson.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jvnet.jaxb2_commons</groupId>
                        <artifactId>jaxb2-basics</artifactId>
                        <version>${jaxb2-basics.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jvnet.jaxb2_commons</groupId>
                        <artifactId>jaxb2-basics-annotate</artifactId>
                        <version>${jaxb2-basics-annotate.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.sun.xml.bind</groupId>
                        <artifactId>jaxb-xjc</artifactId>
                        <version>${jaxb.tools.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.sun.xml.bind</groupId>
                        <artifactId>jaxb-impl</artifactId>
                        <version>${jaxb.tools.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.glassfish.jaxb</groupId>
                        <artifactId>jaxb-core</artifactId>
                        <version>${jaxb.core.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>javax.xml.bind</groupId>
                        <artifactId>jaxb-api</artifactId>
                        <version>${javax.jaxb-api.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.glassfish.jaxb</groupId>
                        <artifactId>jaxb-runtime</artifactId>
                        <version>2.3.5</version>
                    </dependency>
                    <dependency>
                        <groupId>javax.validation</groupId>
                        <artifactId>validation-api</artifactId>
                        <version>2.0.1.Final</version>
                    </dependency>
                </dependencies>

                <configuration>
                    <extension>true</extension>
                </configuration>

                <executions>
                    <execution>
                        <id>api value objects</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/xsd/shared/api.xsd</source>
                            </sources>
                            <xjbSources>
                                <xjbSource>src/main/xsd/binding/api.xjb</xjbSource>
                            </xjbSources>
                            <outputDirectory>${project.build.directory}/generated-sources/xjc/api</outputDirectory>
                            <packageName>za.co.bluepearl.shared.api</packageName>
                            <arguments>
                                <argument>-Xannotate</argument>
                            </arguments>
                            <episodeFileName>api.episode</episodeFileName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>registration value objects</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/xsd/registration/registration.xsd</source>
                            </sources>
                            <xjbSources>
                                <xjbSource>src/main/xsd/binding/registration.xjb</xjbSource>
                            </xjbSources>
                            <outputDirectory>
                                ${project.build.directory}/generated-sources/xjc/registration</outputDirectory>
                            <packageName>za.co.bluepearl.registration.dto</packageName>
                            <arguments>
                                <argument>-Xannotate</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>profile value objects</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/xsd/profile/profile.xsd</source>
                            </sources>
                            <xjbSources>
                                <xjbSource>src/main/xsd/binding/profile.xjb</xjbSource>
                            </xjbSources>
                            <outputDirectory>
                                ${project.build.directory}/generated-sources/xjc/profile</outputDirectory>
                            <packageName>za.co.bluepearl.profile.dto</packageName>
                            <arguments>
                                <argument>-Xannotate</argument>
                                <argument>-b</argument>
                                <argument>${api.episode.file}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>billing value objects</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/xsd/billing/billing.xsd</source>
                            </sources>
                            <xjbSources>
                                <xjbSource>src/main/xsd/binding/billing.xjb</xjbSource>
                            </xjbSources>
                            <outputDirectory>
                                ${project.build.directory}/generated-sources/xjc/billing</outputDirectory>
                            <packageName>za.co.bluepearl.billing.dto</packageName>
                            <arguments>
                                <argument>-Xannotate</argument>
                                <argument>-b</argument>
                                <argument>${api.episode.file}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pdf value objects</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/xsd/pdf/pdf.xsd</source>
                            </sources>
                            <xjbSources>
                                <xjbSource>src/main/xsd/binding/pdf.xjb</xjbSource>
                            </xjbSources>
                            <outputDirectory>${project.build.directory}/generated-sources/xjc/pdf</outputDirectory>
                            <packageName>za.co.bluepearl.pdf.dto</packageName>
                            <arguments>
                                <argument>-Xannotate</argument>
                                <argument>-b</argument>
                                <argument>${api.episode.file}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <excludeTransitive>true</excludeTransitive>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>write-xjc-sources-to-file</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>find</executable>
                            <commandlineArgs>target/generated-sources/xjc -name "*.java" </commandlineArgs>
                            <outputFile>target/xjc-sources.txt</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-generated-xjc-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>javac</executable>
                            <commandlineArgs>--release ${maven.compiler.release} -cp
                                "${project.build.directory}/dependency/*"
                                @target/xjc-sources.txt</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/assembly/api.xml</descriptor>
                                <descriptor>src/main/assembly/registration.xml</descriptor>
                                <descriptor>src/main/assembly/profile.xml</descriptor>
                                <descriptor>src/main/assembly/billing.xml</descriptor>
                                <descriptor>src/main/assembly/contracts.xml</descriptor>
                                <descriptor>src/main/assembly/pdf.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>